# Supabase Public Configuration (Vite requires VITE_ prefix for client-accessible variables)
# Replace with your actual Supabase project URL and anon public key from Project Settings -> API.
# NEVER put your secret service_role key here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
